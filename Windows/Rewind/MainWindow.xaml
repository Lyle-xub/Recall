<Window x:Class="Rewind.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Rewind Replica" Width="1240" Height="820" MinWidth="980" MinHeight="650" WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="Manual" ShowInTaskbar="False" Topmost="True" FontFamily="Segoe UI" Foreground="{StaticResource Ink}" KeyDown="Window_KeyDown">
 <Grid Background="#ECECEF" ClipToBounds="True">
  <Image x:Name="DesktopBackdrop" Stretch="Fill" Margin="-45" IsHitTestVisible="False"><Image.Effect><BlurEffect Radius="42" KernelType="Gaussian" RenderingBias="Performance"/></Image.Effect></Image>
  <Rectangle Fill="#32FFFFFF" IsHitTestVisible="False"/>
  <Image x:Name="HomeImage" Margin="24,15,24,135" Stretch="Uniform" Visibility="Collapsed" IsHitTestVisible="False"/>
  <Grid Margin="27,27,27,18">
   <Grid.RowDefinitions><RowDefinition Height="52"/><RowDefinition Height="*"/><RowDefinition Height="124"/></Grid.RowDefinitions>
   <Grid MouseLeftButtonDown="Header_Drag" Panel.ZIndex="5">
    <Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions>
    <Button x:Name="BackButton" Content="×" FontSize="23" Width="38" Height="38" Padding="0" HorizontalAlignment="Left" Click="Back_Click" ToolTip="Close or return to search"/>
    <Border x:Name="SearchBorder" Grid.Column="1" MaxWidth="680" Background="#70FFFFFF" CornerRadius="15">
     <Grid Margin="17,0"><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/><ColumnDefinition Width="25"/></Grid.ColumnDefinitions>
      <TextBlock Text="⌕" FontSize="27" VerticalAlignment="Center"/>
      <Grid Grid.Column="1"><TextBlock x:Name="SearchHint" Text="Search anything you’ve seen, said, or heard" FontSize="18" Opacity="0.75" VerticalAlignment="Center" IsHitTestVisible="False"/>
       <TextBox x:Name="SearchBox" TextChanged="Search_Changed" KeyDown="Search_KeyDown" FontSize="18" Background="Transparent" Padding="0" VerticalContentAlignment="Center"/>
      </Grid>
      <Button Grid.Column="2" Content="×" Padding="0" Background="Transparent" Click="ClearSearch_Click" ToolTip="Clear search"/>
     </Grid>
    </Border>
    <Button Grid.Column="2" Content="···" FontSize="24" Width="38" Height="38" Padding="0" HorizontalAlignment="Right" Click="Menu_Click" ToolTip="Rewind menu">
     <Button.ContextMenu><ContextMenu x:Name="MainMenu">
      <MenuItem x:Name="RecordMenuItem" Header="Start recording" Click="Record_Click"/><Separator/>
      <MenuItem Header="Ask Rewind" Click="Ask_Click"/><MenuItem Header="Settings…" Click="Settings_Click"/>
      <MenuItem Header="Import images…" Click="Import_Click"/><MenuItem Header="Export current results…" Click="Export_Click"/>
      <MenuItem Header="Load more search results" Click="LoadMore_Click"/>
      <MenuItem Header="Jump to date…" Click="Jump_Click"/><Separator/>
      <MenuItem Header="Retry this recording's transcription" Click="RetryTranscript_Click"/>
      <MenuItem Header="Trash / Back to memories" Click="Trash_Click"/><MenuItem Header="Explore demo / Leave demo" Click="Demo_Click"/>
      <MenuItem Header="Show data folder" Click="Folder_Click"/>
      <Separator/><MenuItem Header="Quit Rewind" Click="Quit_Click"/>
     </ContextMenu></Button.ContextMenu>
    </Button>
   </Grid>
   <Grid Grid.Row="1" Margin="27,24,27,14">
    <Grid x:Name="SearchView"><Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><StackPanel x:Name="AppFilters" Orientation="Horizontal"/></ScrollViewer>
     <ScrollViewer x:Name="ResultsScroll" Grid.Row="1" Margin="0,22,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <ItemsControl x:Name="Cards"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
       <ItemsControl.ItemTemplate><DataTemplate><Button Click="Card_Click" Tag="{Binding Frame}" Padding="0" Background="Transparent" Margin="0,0,35,32" HorizontalContentAlignment="Stretch">
        <StackPanel><Border CornerRadius="7" ClipToBounds="True" Background="#22FFFFFF"><Image Source="{Binding Image}" Stretch="Uniform"/></Border>
         <DockPanel Margin="0,8,0,0"><Border Background="{Binding BadgeColor}" CornerRadius="5" Width="22" Height="22" Margin="0,0,7,0" VerticalAlignment="Top"><TextBlock Text="{Binding Initial}" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/></Border>
          <StackPanel><TextBlock Text="{Binding Frame.Title}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Frame.TimeLabel}" FontSize="10" Opacity="0.75"/></StackPanel>
         </DockPanel>
        </StackPanel>
       </Button></DataTemplate></ItemsControl.ItemTemplate>
      </ItemsControl>
     </ScrollViewer>
     <StackPanel x:Name="EmptyResults" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed"><TextBlock Text="No memories found" FontSize="25" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="Try another phrase, app, or date range." Margin="0,12" Opacity="0.65"/></StackPanel>
    </Grid>
    <StackPanel x:Name="Welcome" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
     <TextBlock Text="◀◀" Foreground="White" FontSize="46" HorizontalAlignment="Center" Margin="0,0,0,25"/>
     <TextBlock Text="Find a moment. Get it back." FontSize="31" FontWeight="SemiBold" HorizontalAlignment="Center"/>
     <TextBlock Text="A searchable memory of what you’ve seen, said, and heard.&#10;Recorded on your PC. Yours to keep." FontSize="16" TextAlignment="Center" LineHeight="25" Margin="0,20" Opacity="0.7"/>
     <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12"><Button Content="●  Start recording" Click="Record_Click" Background="#FF2B293D" Foreground="White" Padding="24,14" Margin="0,0,12,0"/><Button Content="Explore the demo" Click="Demo_Click" Padding="24,14"/></StackPanel>
     <Button Content="Set up offline models" Background="Transparent" Click="ModelSetup_Click" FontSize="12"/>
     <TextBlock Text="Ctrl + Shift + Space to rewind, anytime" HorizontalAlignment="Center" FontSize="12" Opacity="0.55" Margin="0,20"/>
    </StackPanel>
    <Grid x:Name="Detail" Visibility="Collapsed"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="TranscriptColumn" Width="290"/></Grid.ColumnDefinitions>
     <Grid Margin="0,0,23,0"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="42"/></Grid.RowDefinitions>
      <Viewbox x:Name="ImageViewbox" Stretch="Uniform"><Canvas x:Name="ImageCanvas" Width="1024" Height="660"><Image x:Name="DetailImage" Width="1024" Height="660"/></Canvas></Viewbox>
      <MediaElement x:Name="VideoPlayer" LoadedBehavior="Manual" UnloadedBehavior="Stop" Stretch="Uniform" Visibility="Collapsed" MediaOpened="Video_Opened"/>
      <Button x:Name="PipButton" HorizontalAlignment="Left" VerticalAlignment="Bottom" Width="170" Margin="0,0,0,12" Padding="3" Click="Pip_Click" ToolTip="Switch between meeting and desktop"><Image x:Name="PipImage" Stretch="Uniform"/></Button>
      <DockPanel Grid.Row="1" Margin="0,10,0,0"><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button Content="T" Click="CopyText_Click" ToolTip="Select recognized text" Padding="9,3"/><Button Content="☆" Click="Star_Click" ToolTip="Star memory" Padding="9,3" Margin="5,0"/><Button Content="▶" Click="Play_Click" ToolTip="Play recording" Padding="9,3"/><Button Content="⌫" Click="Delete_Click" ToolTip="Move to Trash / restore" Padding="9,3" Margin="5,0"/></StackPanel><TextBlock x:Name="DetailTitle" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/></DockPanel>
     </Grid>
     <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="38"/></Grid.RowDefinitions><ScrollViewer x:Name="TranscriptScroll" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="TranscriptPanel"/></ScrollViewer><TextBox Grid.Row="1" x:Name="TranscriptSearch" TextChanged="TranscriptSearch_Changed" ToolTip="Find in transcript" FontSize="12"/></Grid>
    </Grid>
    <Border x:Name="AskPanel" Visibility="Collapsed" Background="#22FFFFFF" CornerRadius="23" Padding="24">
     <Grid><Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="*"/><RowDefinition Height="65"/><RowDefinition Height="20"/></Grid.RowDefinitions>
      <DockPanel><Button Content="New chat" Click="NewChat_Click" DockPanel.Dock="Right" FontSize="12" Margin="10,0,0,0"/><Button Content="Model settings" Click="ModelSetup_Click" DockPanel.Dock="Right" FontSize="12"/><TextBlock Text="✦  Ask Rewind" FontSize="25" FontWeight="SemiBold"/></DockPanel>
      <ScrollViewer Grid.Row="1" x:Name="ChatScroll" Margin="0,15" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="ChatMessages"><TextBlock Text="Your memories, connected.&#10;&#10;Ask about something you saw or heard. Answers link back to the moments they came from." FontSize="23" TextWrapping="Wrap" Margin="20,50"/></StackPanel></ScrollViewer>
      <DockPanel Grid.Row="2" Margin="0,10"><Button x:Name="SendButton" Content="↑" FontSize="23" Width="46" DockPanel.Dock="Right" Click="Send_Click" Background="#FF2B293D" Foreground="White"/><TextBox x:Name="QuestionBox" KeyDown="Question_KeyDown" FontSize="16" ToolTip="Ask about your memories" VerticalContentAlignment="Center"/></DockPanel>
      <TextBlock x:Name="ModelStatus" Grid.Row="3" FontSize="10" Opacity="0.65"/>
     </Grid>
    </Border>
   </Grid>
   <Grid Grid.Row="2" PreviewMouseWheel="Timeline_Wheel"><Grid.RowDefinitions><RowDefinition Height="37"/><RowDefinition Height="54"/><RowDefinition Height="23"/></Grid.RowDefinitions>
    <TextBlock x:Name="StatusLabel" Text="Everything stays on this device" FontSize="10" Opacity="0.7" VerticalAlignment="Center"/>
    <Button x:Name="DateButton" Content="Now" HorizontalAlignment="Center" Padding="15,6" FontSize="11" Click="Jump_Click"/>
    <Slider x:Name="ZoomSlider" Minimum="1" Maximum="12" Value="1" Width="110" HorizontalAlignment="Right" VerticalAlignment="Center" ToolTip="Timeline zoom" ValueChanged="Zoom_Changed"/>
    <Border Grid.Row="1" Background="#44FFFFFF" CornerRadius="9"><ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><StackPanel x:Name="TimelineTracks" Orientation="Horizontal" Margin="10,6"/></ScrollViewer></Border>
    <DockPanel Grid.Row="2" Margin="4,6,4,0"><TextBlock x:Name="FirstTime" FontSize="10" Opacity="0.6"/><TextBlock x:Name="LastTime" DockPanel.Dock="Right" FontSize="10" Opacity="0.6"/><TextBlock Text="‹   Scroll through time   ›" FontSize="10" Opacity="0.6" HorizontalAlignment="Center"/></DockPanel>
   </Grid>
  </Grid>
  <Border x:Name="Toast" Visibility="Collapsed" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,154" Padding="18,10" Background="#EFFFFFFF" CornerRadius="20"><TextBlock x:Name="ToastText" FontSize="13"/></Border>
 </Grid>
</Window>
