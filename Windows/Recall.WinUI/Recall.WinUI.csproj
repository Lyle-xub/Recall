<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.22621.0</TargetPlatformMinVersion>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWinUI>true</UseWinUI>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <EnableDefaultPageItems>false</EnableDefaultPageItems>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <WindowsAppSdkBootstrapInitialize>false</WindowsAppSdkBootstrapInitialize>
    <ProjectPriFileName>resources.pri</ProjectPriFileName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ApplicationManifest>../Rewind/app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/Recall.ico</ApplicationIcon>
    <AssemblyName>Recall</AssemblyName>
    <RootNamespace>Recall</RootNamespace>
    <Version>0.4.25</Version>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RecallSourceCheck)' == 'true'">
    <!-- Source validation on non-Windows hosts is not a distributable build. -->
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <AppxGeneratePriEnabled>false</AppxGeneratePriEnabled>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Recall.Ocr/Recall.Ocr.csproj"/>
    <EmbeddedResource Include="Materials/Effects/Shaders/LiquidGlass.hlsl" />
    <None Update="Materials/LICENSE" Link="licenses/RecallGlass/LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="Materials/NOTICE.md" Link="licenses/RecallGlass/NOTICE.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- LiquidGlassWinUI’s native effect ABI is tied to this self-contained runtime. -->
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="[2.2.0]" />
    <PackageReference Include="LiquidGlassWinUI" Version="[1.0.3]" />
    <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.4.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <PackageReference Include="ScreenRecorderLib" Version="7.0.1" />
    <PackageReference Include="Tesseract" Version="5.2.0" />
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../Rewind/ScreenManifest.cs;../Rewind/ImageArchive.cs;../Rewind/NeuralOcrClient.cs;../Rewind/Models.cs;../Rewind/AppPaths.cs;../Rewind/DataDirectoryMigration.cs;../Rewind/MemoryStore.cs;../Rewind/MemorySearch.cs;../Rewind/AppUsage.cs;../Rewind/RecordingCoordinator.cs;../Rewind/AudioTrackPolicy.cs;../Rewind/TranscriptPresentation.cs;../Rewind/CaptureService.cs;../Rewind/ModelClient.cs;../Rewind/BuiltinModels.cs" Link="Core/%(Filename).cs" />
    <Content Include="Assets/**" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../Rewind/tessdata/**" Link="tessdata/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../shared/models/**" Link="models/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../native-runtimes/windows-x64/**" Link="runtimes/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../shared/licenses/**" Link="licenses/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="PublishRecallResources" AfterTargets="ComputeFilesToPublish"
          DependsOnTargets="_GenerateProjectPriFile" Condition="'$(RecallSourceCheck)' != 'true'">
    <!-- Unpackaged apps load the merged control resources from this name.
         The SDK generates the PRI for code-only projects but does not add it
         to dotnet publish's file list automatically. -->
    <Error Condition="!Exists('$(ProjectPriFullPath)')" Text="Recall's merged WinUI resource index was not generated." />
    <ItemGroup>
      <ResolvedFileToPublish Include="$(ProjectPriFullPath)" RelativePath="resources.pri" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
</Project>
